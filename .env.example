# Copy to .env for local development. In production these are set in the hosting dashboard
# (Vercel → Project → Settings → Environment Variables), not committed.

# Where the API lives.
VITE_API_BASE=http://localhost:8080

# Google Maps Platform browser key — address search and lookup in the load form (lib/places).
# Optional: without it the form falls back to OpenStreetMap. It ships in the page, so the key
# must be restricted to our domains in the Google Cloud console.
VITE_GOOGLE_MAPS_KEY=
